{
  "name": "fotograma-studio",
  "productName": "Fotograma Studio",
  "version": "3.2.0",
  "description": "Editor de vídeo de escritorio con captura de pantalla y clips instantáneos: unir, recortar, comprimir, velocidad, fotogramas y filtros de color.",
  "main": "main.js",
  "author": "Manuel Bustamante",
  "license": "MIT",
  "scripts": {
    "start": "node scripts/start.js",
    "test": "node test/engine-test.js",
    "icon": "electron scripts/make-icon.js",
    "vendor": "node scripts/vendor-ffmpeg.js",
    "dist": "node scripts/vendor-ffmpeg.js && electron-builder --win nsis portable"
  },
  "build": {
    "appId": "com.fotograma.studio",
    "productName": "Fotograma Studio",
    "copyright": "© 2026 Manuel Bustamante",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "preload-voice.js",
      "src/**",
      "renderer/**",
      "build/icon.png",
      "package.json",
      "!node_modules/ffmpeg-static/**",
      "!node_modules/ffprobe-static/**"
    ],
    "extraResources": [
      {
        "from": "vendor/ffmpeg",
        "to": "ffmpeg"
      }
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Fotograma Studio",
      "artifactName": "Fotograma-Studio-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Fotograma-Studio-Portable-${version}.${ext}"
    },
    "fileAssociations": [
      {
        "ext": "fgproj",
        "name": "Proyecto de Fotograma Studio",
        "description": "Proyecto de Fotograma Studio",
        "role": "Editor"
      }
    ]
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "vosk-browser": "^0.0.8"
  },
  "devDependencies": {
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0"
  }
}
